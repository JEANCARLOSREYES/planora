DATABASE_URL="file:./prisma/dev.db"
# Optional hosted database for serverless deployment; leave blank locally.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
BETTER_AUTH_URL="http://127.0.0.1:3000"
# Set a randomly generated secret of at least 32 characters in your private .env.
BETTER_AUTH_SECRET=""
# Hosted free launch uses Google; local password mode remains the default.
AUTH_MODE="password"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Required only for hosted password mode; never commit real keys.
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""
